# -- AI Booking Demo -------------------------------------

# Google AI Studio key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional. Code defaults to gemini-2.5-flash if unset
GEMINI_MODEL=gemini-2.5-flash

# Telegram bot token from @BotFather (command: /newbot)
TELEGRAM_BOT_TOKEN=

# Chat id that receives booking alerts (yours or a group)
TELEGRAM_CHAT_ID=
