# -- AI Booking Demo -------------------------------------

# Google AI Studio key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional. Code defaults to gemini-2.5-flash if unset
GEMINI_MODEL=gemini-2.5-flash

# Telegram bot token from @BotFather (command: /newbot)
TELEGRAM_BOT_TOKEN=

# Chat id that receives booking alerts (yours or a group)
TELEGRAM_CHAT_ID=

# 24/7 automation
BOOKING_HOLD_HOURS=24
TELEGRAM_ADMIN_CHAT_IDS=7142717055

# chat bookings: confirmed (instant lock, default) or reserved (24h hold + Confirm button)
BOOKING_CHAT_STATUS=confirmed
